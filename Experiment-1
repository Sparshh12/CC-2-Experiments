EXPERIMENT 1.1 – CONTAINS DUPLICATE (LEETCODE 217)

AIM:
To determine whether an integer array contains any duplicate elements using the C++ STL unordered_set.

ALGORITHM:
1.Start.
2.Input the integer array nums.
3.Create an empty unordered_set.
4.Traverse each element in the array.
5.If the current element already exists in the set, return true.
6.Otherwise, insert the element into the set.
7.If the traversal completes without finding duplicates, return false.
8.End.

CODE:
#include <iostream>
#include <vector>
#include <unordered_set>
using namespace std;

class Solution {
public:
    bool containsDuplicate(vector<int>& nums) 
    {
        unordered_set<int>seen;
            for (int num : nums)
            {
            if (seen.count(num))
                return true;
            seen.insert(num);
            }
         return false;
      }
 };

int main() 
    {
    Solution obj;
    vector<int> nums = {1, 2, 3, 1};
    if (obj.containsDuplicate(nums))
    cout << "True";
    else
    cout << "False";
    return 0;
    }



EXPERIMENT 1.2 – CONTAINS DUPLICATE II (LEETCODE 219)


AIM:
To determine whether an integer array contains duplicate elements such that the absolute difference between their indices is at most k using C++ STL unordered_map.

ALGORITHM:
1.Start.
2.Input the integer array nums and integer k.
3.Create an empty unordered_map to store each element and its latest index.
4.Traverse the array.
5.If the current element already exists in the map:
6.Calculate the difference between the current index and the stored index.
7.If the difference is less than or equal to k, return true.
8.Update the current index of the element in the map.
9.If no such pair is found, return false.
10.End.

C++ CODE:

#include <iostream>
#include <vector>
#include <unordered_map>
using namespace std;

class Solution {
public:
    bool containsNearbyDuplicate(vector<int>& nums, int k) {
    unordered_map<int, int> mp;
          for (int i = 0; i < nums.size(); i++) {
            if (mp.count(nums[i]) && i - mp[nums[i]] <= k)
                return true;
                mp[nums[i]] = i;
              }
               return false;
           }
       };

int main() {
    Solution obj;
    vector<int> nums = {1, 2, 3, 1};
    int k = 3;

    if (obj.containsNearbyDuplicate(nums, k))
        cout << "True";
    else
        cout << "False";
    return 0;
}




